---
import SiteLayout from '../components/SiteLayout.astro';
import SneakerCard from '../components/SneakerCard.astro';
import products, { sitePath } from '../data/products.js';
---

<SiteLayout>
	<section class="collection-scene" aria-label="SHOEX sneaker installation" style={`--cave-wall: url("${sitePath('cave-wall.svg')}")`}>
		<div class="collection-intro">
			<div class="intro-kicker"><span class="kicker-line"></span> A STUDY IN SNEAKERS <span class="kicker-line"></span></div>
			<h1>Objects in <em>light.</em></h1>
			<p>Eight considered forms. Made to move with you.</p>
		</div>

		<div class="wall-topline"><span>THE COLLECTION</span><span>NO. 001 — 008</span></div>
		<div class="display-wall">
			<div class="wall-light" aria-hidden="true"></div>
			<div class="collection-grid">
				{products.map((product, index) => <SneakerCard product={product} index={index} />)}
			</div>
			<div class="wall-caption"><span>CURATED IN THE CITY</span><span>SPRING / EDITION 01</span></div>
		</div>

		<div class="closing-note" aria-label="Collection note">
			<span>BUILT WITH INTENTION.</span>
			<span>WORN YOUR WAY.</span>
		</div>
	</section>
</SiteLayout>

<style>
	.collection-scene {
		position: relative;
		isolation: isolate;
		min-height: calc(100vh - 148px);
		padding: 1px 0 8px;
		overflow: hidden;
		background-color: #30312f;
		background-image:
			linear-gradient(180deg, rgba(20,21,21,.28), rgba(20,21,21,.12) 36%, rgba(15,16,16,.35)),
			var(--cave-wall);
		background-position: center;
		background-size: cover;
	}
	.collection-scene::before, .collection-scene::after {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		pointer-events: none;
	}
	.collection-scene::before {
		background: radial-gradient(ellipse at 50% 49%, transparent 13%, rgba(8,9,9,.16) 72%, rgba(8,9,9,.52));
	}
	.collection-scene::after {
		opacity: .18;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.22'/%3E%3C/svg%3E");
		mix-blend-mode: soft-light;
	}
	.collection-intro { padding: clamp(25px, 4vh, 43px) 20px 24px; text-align: center; }
	.intro-kicker { display: flex; align-items: center; justify-content: center; gap: 13px; color: #d3d1c9; font-size: 9px; letter-spacing: .23em; text-shadow: 0 2px 8px rgba(0,0,0,.6); }
	.kicker-line { width: 25px; height: 1px; background: #aaa9a1; }
	h1 { margin: 11px 0 4px; font-family: var(--serif); font-size: clamp(47px, 6vw, 68px); font-weight: 400; line-height: .96; letter-spacing: -.05em; text-shadow: 0 4px 20px rgba(0,0,0,.5); }
	h1 em { color: #e2ded2; font-weight: 400; }
	.collection-intro p { margin: 11px 0 0; color: #d0cec6; font-size: 10px; letter-spacing: .07em; text-shadow: 0 2px 8px rgba(0,0,0,.65); }
	.wall-topline, .wall-caption { display: flex; justify-content: space-between; color: rgba(232,230,222,.76); font-size: 8px; letter-spacing: .2em; text-shadow: 0 2px 7px rgba(0,0,0,.75); }
	.wall-topline { width: min(65vw, 920px); margin: 0 auto; padding: 0 2px 12px; }
	.display-wall { position: relative; width: min(65vw, 920px); margin: 0 auto; padding: clamp(17px, 2.2vw, 28px) clamp(18px, 2.2vw, 30px) 19px; }
	.wall-light { position: absolute; top: -40px; left: 50%; transform: translateX(-50%); width: min(600px, 82%); height: 260px; pointer-events: none; background: radial-gradient(ellipse at 50% 0%, rgba(255,255,238,.32), rgba(255,255,238,.1) 37%, transparent 75%); filter: blur(22px); }
	.collection-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(17px, 2vw, 28px) clamp(12px, 1.65vw, 24px); }
	.wall-caption { position: relative; z-index: 1; padding: 21px 2px 0; }
	.closing-note { min-height: 65px; display: flex; align-items: center; justify-content: center; gap: clamp(20px, 6vw, 90px); color: rgba(226,224,216,.75); font-size: 8px; letter-spacing: .2em; text-shadow: 0 2px 8px rgba(0,0,0,.75); }
	@media (max-width: 900px) {
		.wall-topline, .display-wall { width: min(88vw, 760px); }
		.collection-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 20px 25px; }
	}
	@media (max-width: 560px) {
		.collection-scene { min-height: calc(100vh - 140px); background-position: center; }
		.collection-intro { padding: 30px 16px 21px; }
		.collection-intro p { font-size: 9px; }
		.wall-topline { width: calc(100% - 32px); }
		.display-wall { width: calc(100% - 24px); padding: 14px 10px 15px; }
		.collection-grid { gap: 19px 12px; }
		.wall-topline, .wall-caption { font-size: 7px; letter-spacing: .15em; }
		.wall-caption { padding-top: 18px; }
		.closing-note { min-height: 58px; gap: 15px; font-size: 7px; }
	}
</style>
