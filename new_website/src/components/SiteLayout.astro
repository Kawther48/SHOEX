---
import { sitePath } from '../data/products.js';
const { title = 'SHOEX — A study in sneakers', description = 'A considered collection of sneakers, displayed in light.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#171818" />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,500;1,600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
		<style is:global>
			:root {
				color-scheme: dark;
				--ink: #e8e7e2;
				--muted: #a4a39e;
				--dim: #777772;
				--black: #171818;
				--black-soft: #1d1e1e;
				--line: rgba(235, 233, 224, 0.13);
				--accent: #d7d0c0;
				--serif: 'Cormorant Garamond', 'Bodoni 72', 'Times New Roman', serif;
				--sans: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
				font-family: var(--sans);
				background: var(--black);
				color: var(--ink);
				font-synthesis: none;
				text-rendering: optimizeLegibility;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}
			*, *::before, *::after { box-sizing: border-box; }
			body { margin: 0; min-width: 320px; min-height: 100vh; background: var(--black); }
			a { color: inherit; }
			button, input { font: inherit; }
			button { color: inherit; }
			:focus-visible { outline: 2px solid #e8e3d7; outline-offset: 4px; }
			.site-header { height: 72px; padding: 0 clamp(20px, 5vw, 78px); display: flex; align-items: center; justify-content: space-between; gap: 20px; background: #141515; border-bottom: 1px solid rgba(255,255,255,.07); position: relative; z-index: 4; }
			.wordmark { text-decoration: none; font-family: var(--serif); font-size: 32px; font-style: italic; font-weight: 500; letter-spacing: -.055em; line-height: 1; }
			.wordmark span { font-family: var(--sans); font-size: 8px; font-style: normal; font-weight: 500; letter-spacing: .22em; color: var(--muted); margin-left: 9px; vertical-align: 3px; }
			.header-nav { display: flex; align-items: center; gap: clamp(18px, 3.2vw, 46px); }
			.header-nav a { text-decoration: none; font-size: 10px; text-transform: uppercase; letter-spacing: .14em; color: #c5c4bf; transition: color .2s ease; }
			.header-nav a:hover { color: #fff; }
			.header-bag { display: inline-flex; align-items: center; gap: 9px; }
			.bag-icon { width: 18px; height: 21px; display: block; }
			.bag-count { min-width: 19px; height: 19px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.3); border-radius: 50%; font-size: 9px; line-height: 1; letter-spacing: 0; }
			.site-footer { min-height: 76px; padding: 20px clamp(20px, 5vw, 78px); display: flex; align-items: center; justify-content: space-between; gap: 20px; background: #141515; border-top: 1px solid rgba(255,255,255,.08); color: #a8a7a1; font-size: 10px; letter-spacing: .08em; }
			.footer-mark { font-family: var(--serif); font-style: italic; font-size: 17px; color: #ddd9ce; }
			.image-credit { color: #8f8e87; font-size: 9px; }
			.image-credit a { color: #bdbbb2; text-underline-offset: 3px; }
			@media (max-width: 900px) { .site-footer { flex-wrap: wrap; justify-content: center; text-align: center; } }
			@media (max-width: 560px) {
				.site-header { height: 64px; padding-inline: 18px; }
				.wordmark { font-size: 27px; }
				.wordmark span { display: none; }
				.header-nav { gap: 15px; }
				.header-nav a { font-size: 9px; letter-spacing: .1em; }
				.site-footer { align-items: flex-start; flex-direction: column; gap: 8px; padding-inline: 20px; font-size: 9px; }
			}
			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
			}
		</style>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href={sitePath()} aria-label="SHOEX home">shoex<span>OBJECTS FOR THE EVERYDAY</span></a>
			<nav class="header-nav" aria-label="Main navigation">
				<a href={sitePath()}>The collection</a>
				<a class="header-bag" href={sitePath('bag/')} aria-label="Shopping bag, 0 items">
					<svg class="bag-icon" viewBox="0 0 20 24" fill="none" aria-hidden="true"><path d="M3 8h14l1.2 13H1.8L3 8Z" stroke="currentColor" stroke-width="1.2"/><path d="M6.5 9V6a3.5 3.5 0 0 1 7 0v3" stroke="currentColor" stroke-width="1.2"/></svg>
					<span>BAG</span><span class="bag-count" aria-live="polite">0</span>
				</a>
			</nav>
		</header>
		<main><slot /></main>
		<footer class="site-footer">
			<span class="footer-mark">shoex</span>
			<span>This is not a real store. This website is for demonstration purposes only.</span>
			<span>DESIGNED TO BE WORN, NOT STORED.</span>
			<span class="image-credit">Sneaker cut-outs: <a href="https://pngimg.com" target="_blank" rel="noreferrer">PNGimg.com</a> · <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noreferrer">CC BY-NC 4.0</a></span>
		</footer>
		<script>
			import { readBag } from '../scripts/store.js';
			const updateBagCount = () => {
				const count = readBag().reduce((total, item) => total + item.quantity, 0);
				document.querySelectorAll('.bag-count').forEach((badge) => { badge.textContent = String(count); });
				document.querySelectorAll('.header-bag').forEach((link) => {
					link.setAttribute('aria-label', `Shopping bag, ${count} ${count === 1 ? 'item' : 'items'}`);
				});
			};
			updateBagCount();
			window.addEventListener('storage', updateBagCount);
			window.addEventListener('bag:updated', updateBagCount);
		</script>
	</body>
</html>
